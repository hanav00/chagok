<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos Connect SDK. 모두 일반 앱용(normal)이다. 제어(CONTROL_*)·시스템(PRIVATE_*) 권한은 쓰지 않는다 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" /> <!-- 누적거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" /> <!-- 차대번호 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" /> <!-- 연료·배터리 잔량: 주유·충전 알아채기 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" /> <!-- 동승석 착석: 방문 메모를 혼자일 때만 읽는다 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" /> <!-- 목적지·현재 위치·즐겨찾기 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" /> <!-- 도착 음성 안내 -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" /> <!-- 음성 받아쓰기: 방문 목적·이름 -->

    <!-- AAOS 표준 Car API. 기어(GEAR_SELECTION)는 Pleos 문서 안내대로 SDK 가 아니라 표준 API 로 읽는다 (normal) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 시동 때 화면 없이 기록 서비스를 띄운다 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Gleo 가 깔린 차인지 본다 (첫 실행 "말로 고치기"·설정 "Gleo로 말하기"를 보일지) -->
    <queries>
        <package android:name="ai.umos.ambientai" />
    </queries>

    <application
        android:name=".ChagokApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Chagok">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중 사용(DO) 선언: P단이 아니면 버튼 없이 분류 한 줄만 보여 준다.
                 선언하지 않으면 신호 대기(D·N단)에서도 앱 창 전체가 가려진다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".recorder.RecorderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="업무용 차량 운행기록: 시동 중 계기판 누적거리와 기어를 기록" />
        </service>

        <receiver
            android:name=".recorder.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Gleo 음성 명령. 함수 이름은 assets/schema.json · gleo/GleoProtocol.kt 와 같아야 한다.
             Gleo 는 "패키지명.함수명" 으로 보내지만 공식 문서 예시는 함수명만이라 둘 다 받는다 -->
        <receiver
            android:name=".gleo.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="kr.chagok.SET_TRIP_CATEGORY" />
                <action android:name="kr.chagok.ADD_TRIP_NOTE" />
                <action android:name="kr.chagok.SET_TRIP_USER" />
                <action android:name="SET_TRIP_CATEGORY" />
                <action android:name="ADD_TRIP_NOTE" />
                <action android:name="SET_TRIP_USER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
